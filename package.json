{
  "name": "orrery",
  "version": "0.1.0",
  "private": true,
  "description": "A browser workbench for robots and IoT: run real Arduino firmware against simulated circuits, motors and a 3D mechanism before you build it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "build:examples": "node scripts/build-examples.mjs",
    "compiler": "node scripts/compile-server.mjs",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "mcp": "node dist-mcp/server.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "avr8js": "0.21.1",
    "manifold-3d": "3.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
